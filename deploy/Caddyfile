# HTTPS reverse proxy for public GOwift servers.
# Caddy fetches and renews certificates automatically and proxies WebSockets.

# Landing page (optional, COMPOSE_PROFILES=tls,landing). One or more addresses,
# e.g. "example.org, www.example.org"; www. redirects to the bare domain.
# Unset, it falls back to a local-only address nobody reaches from outside.
{$GOWIFT_LANDING_DOMAIN:http://landing.localhost} {
	@www header_regexp www Host ^www\.(.+)$
	redir @www https://{re.www.1}{uri} permanent

	header {
		Strict-Transport-Security "max-age=31536000"
	}

	reverse_proxy landing:80
}

# The app: game server, client and WebSocket (e.g. app.example.org).
{$GOWIFT_DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
	}

	reverse_proxy server:8080
}
