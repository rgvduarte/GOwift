---
import { Picture } from "astro:assets";
import Base from "../layouts/Base.astro";
import Profile from "../components/Profile.astro";
import { site, appHost, hasApp, coldStart, wakeUrl } from "../site";
import { startLabel } from "../lib/app";
import { routeStats } from "../lib/route";
import { routeFacts } from "../lib/facts";
import hero from "../assets/hero.png";
import studio from "../assets/studio.png";
// The repository's screenshots (also shown in the README), so one set stays current.
import rideShot from "../../../docs/assets/screenshot-ride.png";
import menuShot from "../../../docs/assets/screenshot-menu.png";

const devicesUrl = `${site.githubUrl}/blob/main/docs/devices.md`;

// Without a public server yet, the main buttons lead to "Host your own".
const startUrl = hasApp ? site.appUrl : "#host";
const start = startLabel(hasApp);

// Counted from routes/*.json when the page is built (ADR 0025).
const facts = routeFacts(routeStats());
const [routesFact, lengthFact] = facts;

// Shown next to the buttons when the server sleeps while nobody rides.
const coldStartNote = "The free server naps when nobody rides, so the first start can take up to a minute.";

const steps = [
  {
    title: "Connect your trainer",
    text: "Any smart trainer or power meter that speaks Bluetooth FTMS or Cycling Power, like a Wahoo KICKR Core or a Van Rysel D500. A heart rate strap is optional.",
    link: { href: devicesUrl, label: "Which devices work" },
  },
  {
    title: "Open Chrome or Edge",
    text: "On Windows, macOS, Android or ChromeOS, for Web Bluetooth. On iPhone and iPad, use the free Bluefy browser. Add it to your home screen and it opens like an app.",
  },
  {
    title: "Type a name and ride",
    text: "No sign-up. Pick a route, a spin class or a workout, set your weight and FTP, and go. Strava is optional.",
  },
];

const extras = [
  {
    title: "ERG workouts",
    text: "Ride the built-in sessions or import your own .zwo files. The trainer holds the watts.",
  },
  {
    title: "Virtual shifting",
    text: "Gears for single-speed setups like the Zwift Cog, from the keyboard, the screen or a Zwift Click, Play or Ride.",
  },
  {
    title: "Strava and files",
    text: "Send a ride to Strava with its climbing and a map, or download .fit, .gpx and .tcx.",
  },
  {
    title: "Opens like an app",
    text: "Nothing to install or update. Add it to your home screen and it starts full screen.",
  },
];

const faq = [
  {
    q: "Is it really free?",
    a: "Yes. Riding is free, with no subscription and no paywalled features. The code is open source, so anyone can run their own server too.",
  },
  {
    q: "Do I need an account?",
    a: "No. Enter a name and ride. Your profile (weight, FTP, devices) stays in your browser. Connecting Strava is optional and only needed for uploads.",
  },
  {
    q: "Does it work on an iPhone or iPad?",
    a: "Safari on iOS can’t talk to Bluetooth devices. The free Bluefy browser can: open the app there. Chrome or Edge on Android, Windows, macOS and ChromeOS work out of the box.",
  },
  {
    q: "I don’t have a smart trainer. Can I still try it?",
    a: "Yes. Pick Simulator on the start screen and set your power with the arrow keys. A power meter on a classic trainer works too, without resistance control.",
  },
  {
    q: "Who are the other riders?",
    a: "People, and bots marked as bots. Bots keep the roads busy when few people are online, chase drafts and race, and leave as more humans join.",
  },
  ...(coldStart
    ? [
        {
          q: "Why does the first start take a minute?",
          a: "The public server runs on a free plan that sleeps after 15 minutes without riders. The next visit wakes it, which takes about a minute; while people ride, it stays awake.",
        },
      ]
    : []),
];
---

<Base overlay>
  <section class="hero" aria-labelledby="hero-title">
    <Picture
      class="hero-shot"
      src={hero}
      formats={["avif", "webp"]}
      fallbackFormat="jpg"
      widths={[800, 1200, hero.width]}
      sizes="(max-width: 52rem) 100vh, (max-aspect-ratio: 16/9) 178vh, 100vw"
      alt="A rider in the GOindoor 3D world on a winding country road in evening light, seen from the drone camera."
      loading="eager"
      fetchpriority="high"
    />
    <div class="wrap hero-text">
      <div class="hero-copy">
        <p class="eyebrow">Open source · Runs in your browser</p>
        <h1 id="hero-title">Free indoor cycling, together.</h1>
        <p class="lede">
          Connect your smart trainer, open the browser and ride an island world with friends, strangers and bots. No
          download, no account, no subscription.
        </p>
        <div class="actions">
          <a class="button primary large" href={startUrl} data-wake={wakeUrl}>{start}</a>
          <a class="button large" href="#how">How it works</a>
        </div>
        {
          hasApp && (
            <p class="cta-note">
              Opens {appHost} in Chrome or Edge.
              {coldStart && <span class="cold-start">{coldStartNote}</span>}
            </p>
          )
        }
      </div>
      <ul class="at-a-glance glass" aria-label="At a glance">
        <li><strong>{routesFact.value} routes</strong> {lengthFact.value} in all</li>
        <li><strong>Spin classes</strong> every 30 minutes</li>
        <li><strong>Strava upload</strong> optional</li>
      </ul>
    </div>
    <div class="hero-ground">
      <Profile route="col-de-la-forge" />
    </div>
  </section>

  <section class="section how" id="how" aria-labelledby="how-title">
    <div class="wrap how-grid">
      <header class="section-head">
        <p class="eyebrow">How it works</p>
        <h2 id="how-title">From this page to your first pedal stroke in about two minutes.</h2>
      </header>
      <ol class="steps">
        {
          steps.map((step) => (
            <li>
              <h3>{step.title}</h3>
              <p>
                {step.text}
                {step.link && (
                  <>
                    {" "}
                    <a href={step.link.href}>{step.link.label}</a>
                  </>
                )}
              </p>
            </li>
          ))
        }
      </ol>
      <figure class="how-shot">
        <Picture
          src={menuShot}
          formats={["avif", "webp"]}
          fallbackFormat="jpg"
          widths={[640, 960, 1280, 1600]}
          sizes="(min-width: 60rem) 40rem, calc(100vw - 2rem)"
          alt="The GOindoor start screen: route tabs, the selected route with its elevation profile, route cards with distance and climbing, and the rider panel with name, weight, FTP and how you ride."
        />
        <figcaption>
          The start screen. No trainer? Pick <strong>Simulator</strong> and set your power with the arrow keys.
        </figcaption>
      </figure>
    </div>
  </section>

  <section class="section ride glow" aria-labelledby="ride-title">
    <div class="wrap">
      <header class="section-head">
        <p class="eyebrow">The ride</p>
        <h2 id="ride-title">Everything you need for a winter on the trainer.</h2>
      </header>
      <div class="bento">
        <article class="tile tile-xl glass">
          <div class="tile-text">
            <h3>One island, everyone on it</h3>
            <p>
              Pick a route and you ride the same roads as everyone else on the server: valley, cliffs, a col and three
              cafés.
            </p>
          </div>
          <Picture
            class="tile-shot"
            src={rideShot}
            formats={["avif", "webp"]}
            fallbackFormat="jpg"
            widths={[640, 960, 1280, 1600]}
            sizes="(min-width: 60rem) 48rem, calc(100vw - 2rem)"
            alt="A ride in GOindoor: the rider on a village road, with power, speed, cadence and gradient on screen."
            loading="lazy"
          />
        </article>
        <article class="tile tile-l glass">
          <div class="tile-text">
            <h3>A spin class every 30 minutes</h3>
            <p>Coach Lemon calls the blocks, targets follow your FTP, and the room board ranks time on target.</p>
          </div>
          <Picture
            class="tile-shot studio-shot"
            src={studio}
            formats={["avif", "webp"]}
            fallbackFormat="jpg"
            widths={[640, 960, 1280, 1600]}
            sizes="(min-width: 60rem) 36rem, calc(100vw - 2rem)"
            alt="The GOindoor spin studio: Coach Lemon on stage, riders side by side, and the class targets for power and cadence."
            loading="lazy"
          />
        </article>
        <article class="tile tile-m glass">
          <h3>Never an empty road</h3>
          <p>
            Bots ride along when it’s quiet, each with its own fitness and style. They’re always marked, and make room
            as people join.
          </p>
        </article>
        <article class="tile tile-m glass">
          <h3>Draft, race, sprint</h3>
          <p>
            Sit on a wheel to save watts. Join a race during its countdown, then go for the climbs and the sprints.
          </p>
        </article>
        <ul class="extras glass">
          {
            extras.map((extra) => (
              <li>
                <h3>{extra.title}</h3>
                <p>{extra.text}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <section class="section facts" aria-labelledby="facts-title">
    <div class="wrap">
      <h2 id="facts-title" class="eyebrow">By the numbers</h2>
      <ul class="fact-band glass">
        {
          facts.map((fact) => (
            <li>
              <strong class="fact-value">{fact.value}</strong>
              <span class="fact-label">{fact.label}</span>
            </li>
          ))
        }
      </ul>
      <p class="facts-note">Counted from the game’s own route files when this page was built.</p>
    </div>
  </section>

  <section class="section faq glow" aria-labelledby="faq-title">
    <div class="wrap faq-grid">
      <header class="section-head">
        <p class="eyebrow">Questions</p>
        <h2 id="faq-title">Before your first ride.</h2>
      </header>
      <div class="faq-list glass">
        {
          faq.map((item) => (
            <details>
              <summary>{item.q}</summary>
              <p>{item.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section host" id="host" aria-labelledby="host-title">
    <div class="wrap host-grid">
      <header class="section-head">
        <p class="eyebrow">For clubs and tinkerers</p>
        <h2 id="host-title">Open source. Host your own.</h2>
        <p>
          Every server is a single Docker container. Run one at home for your LAN, on a small VPS for your club{
            hasApp ? ", or ride on ours" : ""
          }. The game server is written in Rust, the client is plain JavaScript.
        </p>
      </header>
      <div class="host-body">
        <pre><code><span class="muted"># needs Docker with Compose and make</span>
git clone {site.githubUrl}.git
cd GOwift
make up</code></pre>
        <p>
          Then open <code>http://localhost:8080</code>. Bug reports, routes and pull requests are welcome on <a
            href={site.githubUrl}>GitHub</a
          >.
        </p>
      </div>
    </div>
  </section>

  <section class="section last-call glow" aria-label="Start riding">
    <div class="wrap">
      <div class="last-call-panel glass">
        <p class="last-call-line">The road is open.</p>
        <div class="last-call-action">
          <a class="button primary large" href={startUrl} data-wake={wakeUrl}>{start}</a>
          {hasApp && <p class="cta-note">Opens {appHost} in Chrome or Edge.</p>}
        </div>
        <p class="community">
          {
            site.discordUrl ? (
              <>
                Looking for riding partners? Meet them on <a href={site.discordUrl}>Discord</a>.
              </>
            ) : (
              <>
                Ideas and bug reports go to <a href={`${site.githubUrl}/issues`}>GitHub issues</a>.
              </>
            )
          }{" "}
          Riding stays free for everyone.
        </p>
      </div>
    </div>
  </section>
</Base>

<style>
  /* Hero: the game's own picture, standing on a real route profile. */
  .hero {
    position: relative;
    min-height: min(100svh, 62rem);
    display: grid;
    grid-template-rows: 1fr auto;
    isolation: isolate;
    overflow: hidden;
  }
  /* The picture is cropped to cover the hero, so on a screen narrower than
     16:9 it is wider than the screen: its `sizes` asks for that width (178vh),
     not the screen's, or the browser picks a file far too small. */
  .hero :global(.hero-shot) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 60% 40%;
    z-index: -2;
  }
  .hero::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(to right, rgb(11 11 12 / 0.88) 0%, rgb(11 11 12 / 0.4) 55%, rgb(11 11 12 / 0) 80%),
      linear-gradient(to bottom, rgb(11 11 12 / 0.6) 0%, rgb(11 11 12 / 0) 25%),
      linear-gradient(to top, rgb(11 11 12 / 0.55) 0%, rgb(11 11 12 / 0) 45%);
  }
  .hero-text {
    align-self: end;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: end;
    gap: var(--s-4);
    padding-top: 7rem;
    padding-bottom: clamp(1.5rem, 4vw, 3rem);
  }
  .hero .eyebrow {
    color: var(--silver);
    margin-bottom: var(--s-2);
    text-shadow: 0 1px 12px rgb(11 11 12 / 0.8);
  }
  h1 {
    font-size: var(--fs-h1);
    line-height: 0.9;
    letter-spacing: -0.045em;
    max-width: 11ch;
    text-shadow: 0 2px 24px rgb(11 11 12 / 0.5);
  }
  .lede {
    margin-top: var(--s-3);
    font-size: clamp(1.125rem, 2vw, 1.3rem);
    color: var(--lede);
    max-width: 34ch;
    text-shadow: 0 1px 12px rgb(11 11 12 / 0.8);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: var(--s-4);
  }
  .actions .button:not(.primary) {
    background: rgb(255 255 255 / 0.09);
  }
  /* On phones the buttons take the full width, one under the other, so the
     page never scrolls sideways. */
  @media (max-width: 30rem) {
    .actions .button {
      flex: 1 1 100%;
    }
  }
  .cta-note {
    margin-top: 0.75rem;
    font-size: 0.875rem;
    color: var(--muted);
    max-width: 44ch;
  }
  .hero .cta-note {
    color: var(--silver);
    text-shadow: 0 1px 8px rgb(11 11 12 / 0.9);
  }
  .cold-start {
    display: block;
  }
  /* Glass over the photo, where its blur shows. */
  .at-a-glance {
    list-style: none;
    margin: 0;
    padding: var(--s-1) var(--s-3);
    min-width: 15rem;
  }
  .at-a-glance li {
    padding-block: 0.7rem;
    font-size: 0.9375rem;
    color: var(--silver);
    line-height: 1.3;
  }
  .at-a-glance li + li {
    border-top: 1px solid var(--divider);
  }
  .at-a-glance strong {
    display: block;
    color: var(--text);
    font-size: 1.0625rem;
  }
  .hero-ground {
    margin-bottom: -1px;
  }
  .hero-ground :global(figcaption) {
    padding-top: 0.25rem;
    background: var(--bg);
  }
  /* Phones: the picture fills the top of the screen with the rider in view,
     fades into the ground, and the text stands on the dark part below. A
     shorter picture is also upscaled less: about 100vh wide (`sizes`)
     instead of the full hero's height times 16:9. */
  @media (max-width: 52rem) {
    .hero {
      --shot-h: max(22rem, 56svh);
      min-height: 0;
    }
    .hero :global(.hero-shot),
    .hero::before {
      inset: 0 0 auto;
      height: var(--shot-h);
    }
    .hero :global(.hero-shot) {
      object-position: 52% 50%;
      -webkit-mask-image: linear-gradient(#000 76%, transparent);
      mask-image: linear-gradient(#000 76%, transparent);
    }
    .hero::before {
      background: linear-gradient(
        to bottom,
        rgb(11 11 12 / 0.72) 0%,
        rgb(11 11 12 / 0.2) 28%,
        rgb(11 11 12 / 0) 50%,
        rgb(11 11 12 / 0.55) 100%
      );
    }
    .hero-text {
      grid-template-columns: minmax(0, 1fr);
      padding-top: calc(var(--shot-h) - 5rem);
    }
    /* One row per item: the name on the left, the detail on the right. */
    .at-a-glance {
      min-width: 0;
      padding: 0.25rem var(--s-3);
    }
    .at-a-glance li {
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      align-items: baseline;
      gap: 0 var(--s-2);
      padding-block: 0.6rem;
    }
    .at-a-glance strong {
      display: inline;
      font-size: 1rem;
    }
  }

  /* Sections */
  .section {
    padding-block: var(--section);
  }
  .section-head {
    margin-bottom: var(--s-6);
  }
  .section-head .eyebrow {
    margin-bottom: var(--s-2);
  }
  .section-head p:not(.eyebrow) {
    margin-top: var(--s-3);
    color: var(--muted);
    max-width: 52ch;
  }

  /* How it works: three steps beside the real start screen. */
  .how-grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    grid-template-areas:
      "head head"
      "steps shot";
    gap: 0 clamp(2rem, 5vw, 4rem);
    align-items: start;
  }
  .how-grid .section-head {
    grid-area: head;
  }
  .steps {
    grid-area: steps;
    list-style: none;
    counter-reset: step;
    margin: 0;
    padding: 0;
  }
  .steps li {
    counter-increment: step;
    display: grid;
    grid-template-columns: 3rem 1fr;
    column-gap: var(--s-2);
    padding-block: var(--s-3);
    border-top: 1px solid var(--divider);
  }
  .steps li:first-child {
    padding-top: 0;
    border-top: 0;
  }
  .steps li::before {
    content: counter(step);
    grid-row: span 2;
    font-weight: 700;
    font-size: 2.75rem;
    line-height: 0.85;
    letter-spacing: -0.04em;
    color: var(--brand);
  }
  .steps h3 {
    margin-bottom: 0.4rem;
  }
  .steps p {
    color: var(--muted);
    font-size: var(--fs-card);
  }
  .steps a {
    color: var(--text);
    white-space: nowrap;
  }
  .how-shot {
    grid-area: shot;
    margin: 0;
  }
  .how-shot :global(img) {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius);
    border: 1px solid var(--border);
    border-top-color: var(--glass-top);
    background: var(--surface);
  }
  .how-shot figcaption {
    margin-top: var(--s-2);
    color: var(--muted);
    font-size: 0.9375rem;
  }
  .how-shot strong {
    color: var(--text);
  }
  @media (max-width: 52rem) {
    .how-grid {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas: "head" "steps" "shot";
    }
    .how-shot {
      margin-top: var(--s-4);
    }
  }

  /* The ride: a bento of real screenshots and short tiles. */
  .bento {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: var(--s-2);
  }
  .tile {
    position: relative;
    overflow: hidden;
    padding: var(--s-4);
  }
  .tile h3 {
    margin-bottom: var(--s-1);
  }
  .tile p {
    color: var(--muted);
    font-size: var(--fs-card);
    line-height: 1.5;
  }
  .tile-xl {
    grid-column: span 8;
    grid-row: span 2;
    min-height: 34rem;
  }
  .tile-l {
    grid-column: span 4;
    grid-row: span 2;
  }
  .tile-m {
    grid-column: span 6;
  }
  /* The smaller features share one glass strip instead of four more cards. */
  .extras {
    grid-column: 1 / -1;
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }
  .extras li {
    padding: var(--s-3);
  }
  .extras li + li {
    border-left: 1px solid var(--divider);
  }
  .extras h3 {
    font-size: 1.0625rem;
    margin-bottom: 0.35rem;
  }
  .extras p {
    color: var(--muted);
    font-size: 0.9375rem;
    line-height: 1.45;
  }
  .tile-text {
    position: relative;
    z-index: 1;
    max-width: 30rem;
  }
  /* The screenshot fills the tile's lower part and fades into the glass. */
  .tile :global(.tile-shot) {
    position: absolute;
    inset: auto 0 0;
    width: 100%;
    height: 74%;
    object-fit: cover;
    object-position: 50% 100%;
    /* The fade also hides the game's top bar, which a narrow crop would cut. */
    -webkit-mask-image: linear-gradient(transparent 10%, #000 36%);
    mask-image: linear-gradient(transparent 10%, #000 36%);
  }
  .tile :global(.studio-shot) {
    height: 62%;
    object-position: 50% 78%;
  }
  @media (max-width: 60rem) {
    .bento {
      grid-template-columns: minmax(0, 1fr);
    }
    .tile-xl,
    .tile-l,
    .tile-m {
      grid-column: 1 / -1;
      grid-row: auto;
    }
    .tile-xl,
    .tile-l {
      min-height: min(30rem, 120vw);
    }
    .extras {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .extras li:nth-child(3) {
      border-left: 0;
    }
    .extras li:nth-child(n + 3) {
      border-top: 1px solid var(--divider);
    }
  }
  @media (max-width: 30rem) {
    .tile {
      padding: var(--s-3);
    }
    .extras {
      grid-template-columns: minmax(0, 1fr);
    }
    .extras li + li {
      border-left: 0;
      border-top: 1px solid var(--divider);
    }
  }

  /* By the numbers */
  .facts {
    padding-block: 0;
  }
  .facts .eyebrow {
    margin-bottom: var(--s-2);
  }
  .fact-band {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }
  .fact-band li {
    padding: var(--s-4) var(--s-3);
    display: grid;
    gap: var(--s-1);
    align-content: start;
    /* The numbers scale with their column, so "4,138 m" always fits. */
    container-type: inline-size;
  }
  .fact-band li + li {
    border-left: 1px solid var(--divider);
  }
  .fact-value {
    font-size: clamp(1.75rem, 4.4vw, 3.5rem);
    font-size: clamp(1.5rem, 23cqi, 3.5rem);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.04em;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .fact-label {
    color: var(--muted);
    font-size: 0.9375rem;
    line-height: 1.35;
  }
