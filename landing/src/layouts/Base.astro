---
import "../styles/global.css";
import { site, appHost, rideUrl, href, wakeUrl } from "../site";
import GoGlyphs from "../components/GoGlyphs.astro";
import GdMark from "../components/GdMark.astro";
import Prewarm from "../components/Prewarm.astro";

interface Props {
  title?: string;
  description?: string;
  /** The header floats over the page's first section (the home hero). */
  overlay?: boolean;
}

const { title, description = site.description, overlay = false } = Astro.props;
const fullTitle = title ? `${title} – ${site.name}` : `${site.name} – free indoor cycling, together`;
const canonical = new URL(Astro.url.pathname, site.url).href;
const ogImage = new URL(href("og.png"), site.url).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#0b0b0c" />
    <link rel="icon" href={href("icons/favicon-32.png")} type="image/png" sizes="32x32" />
    <link rel="icon" href={href("icons/favicon-64.png")} type="image/png" sizes="64x64" />
    <link rel="apple-touch-icon" href={href("icons/apple-touch-icon.png")} />
    <link rel="sitemap" href={href("sitemap-index.xml")} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    {site.plausibleDomain && <script is:inline defer data-domain={site.plausibleDomain} src={site.plausibleScript} />}
    <slot name="head" />
  </head>
  <body>
    <a class="skip button" href="#content">Skip to content</a>
    <header class:list={["top", { overlay }]}>
      <div class="wrap top-inner">
        <a class="brand" href={href()} aria-label="GOindoor home">
          <GdMark />
          <span><GoGlyphs />indoor</span>
        </a>
        <nav aria-label="Main">
          <a class="nav-link" href={site.githubUrl}>GitHub</a>
          <a class="button primary compact" href={rideUrl} aria-label={`Ride now on ${appHost}`} data-wake={wakeUrl}
            >Ride now</a
          >
        </nav>
      </div>
    </header>

    <main id="content">
      <slot />
    </main>

    <footer class="foot">
      <div class="wrap foot-inner">
        <p>
          <span class="brand-word"><GoGlyphs />indoor</span> is open source.
          <span class="muted">
            Created and developed by <a href={site.ownerUrl}>{site.owner}</a>. Based on{" "}
            <a href={site.upstreamUrl}>OpenRadlr</a>. Hero image © The OpenRadlr contributors,{" "}
            <a href="https://creativecommons.org/licenses/by-sa/4.0/">CC BY-SA 4.0</a>{" "}
            (<a href={`${site.githubUrl}/blob/main/ASSETS-LICENSE.md`}>artwork credits</a>).
          </span>
        </p>
        <nav aria-label="Footer">
          <a href={rideUrl}>Open the app</a>
          <a href={href("changelog/")}>Changelog</a>
          <a href={site.githubUrl}>GitHub</a>
          {site.privacyUrl && <a href={site.privacyUrl}>Privacy</a>}
          {site.imprintUrl && <a href={site.imprintUrl}>Imprint</a>}
        </nav>
      </div>
    </footer>
    {wakeUrl && <Prewarm />}
  </body>
</html>

<style>
  .top {
    padding-block: 1.25rem;
  }
  .top.overlay {
    position: absolute;
    inset: 0 0 auto;
    z-index: 5;
  }
  .top-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
    font-size: 1.6rem;
    font-weight: 700;
    letter-spacing: -0.03em;
    color: var(--silver);
  }

  .brand:hover {
    color: var(--text);
  }
  nav {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }
  .nav-link {
    text-decoration: none;
    font-weight: 600;
  }
  .brand-word {
    font-weight: 700;
    color: var(--silver);
  }
  .foot {
    border-top: 1px solid var(--border);
    padding-block: 2.5rem 3rem;
    font-size: 0.9375rem;
  }
  .foot-inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1.5rem 3rem;
  }
  .foot p {
    max-width: 44ch;
  }
  .foot p .muted {
    display: block;
    margin-top: 0.25rem;
  }
  .foot nav {
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 0.5rem 1.5rem;
  }
  @media (max-width: 30rem) {
    .nav-link {
      display: none;
    }
  }
</style>
