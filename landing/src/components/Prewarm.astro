---
// Wakes a sleeping game server while the visitor reads (ADR 0025): once a
// *Ride* link (`data-wake`) is on screen after the page has loaded and the
// browser is idle, or as soon as someone points at, focuses or touches one.
// The logic lives in lib/prewarm.ts; this only wires it to the page.
---

<script>
  import { createWake } from "../lib/prewarm";

  const links = [...document.querySelectorAll<HTMLElement>("[data-wake]")];
  const wake = createWake(links[0]?.dataset.wake ?? null, {
    fetch: (url, init) => fetch(url, init),
    connection: (navigator as Navigator & { connection?: { saveData?: boolean } }).connection,
  });

  for (const link of links) {
    for (const type of ["pointerenter", "focus", "touchstart"]) {
      link.addEventListener(type, wake, { once: true, passive: true });
    }
  }

  // The page itself comes first: wait for load and an idle moment.
  const whenIdle = (run: () => void) =>
    "requestIdleCallback" in window ? requestIdleCallback(run) : setTimeout(run, 200);
  const watch = () => {
    if (!("IntersectionObserver" in window)) return wake();
    const seen = new IntersectionObserver((entries) => {
      if (!entries.some((entry) => entry.isIntersecting)) return;
      seen.disconnect();
      wake();
    });
    links.forEach((link) => seen.observe(link));
  };
  if (document.readyState === "complete") whenIdle(watch);
  else addEventListener("load", () => whenIdle(watch), { once: true });
</script>
