---
// A Copy button for the code block with the id `target`. Where the
// clipboard is unavailable it selects the code instead, for a manual copy.
interface Props {
  target: string;
}
const { target } = Astro.props;
---

<button type="button" class="copy" data-copy={target} aria-describedby={`${target}-status`}>Copy</button>
<span class="copy-status" id={`${target}-status`} role="status"></span>

<script>
  import { copyText } from "../lib/copy";

  for (const button of document.querySelectorAll<HTMLButtonElement>("button[data-copy]")) {
    const code = document.getElementById(button.dataset.copy ?? "");
    const status = button.nextElementSibling;
    if (!code || !status) continue;
    let reset: ReturnType<typeof setTimeout> | undefined;
    button.addEventListener("click", async () => {
      const copied = await copyText(code.textContent ?? "", navigator.clipboard);
      if (!copied) {
        // Select the commands so Ctrl+C or the context menu copies them.
        getSelection()?.selectAllChildren(code);
      }
      button.textContent = copied ? "Copied" : "Selected";
      status.textContent = copied ? "Commands copied." : "Commands selected: copy them with your keyboard or menu.";
      clearTimeout(reset);
      reset = setTimeout(() => {
        button.textContent = "Copy";
        status.textContent = "";
      }, 2000);
    });
  }
</script>

<style>
  .copy {
    position: absolute;
    top: 0.6rem;
    right: 0.6rem;
    min-height: 36px;
    padding: 0.35em 0.9em;
    border-radius: 10px;
    border: 1px solid var(--border);
    border-top-color: var(--glass-top);
    background: var(--surface);
    color: var(--text);
    font: inherit;
    font-size: 0.875rem;
    font-weight: 700;
    cursor: pointer;
  }
  .copy:hover {
    border-color: var(--muted);
  }
  .copy-status {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
</style>
