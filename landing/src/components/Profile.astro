---
// The elevation profile of a real route, drawn as the ground the hero stands
// on: the area below the line is filled with the page colour, climbs are
// traced red and sprints blue, as on the app's profile.
import { loadProfile, simplifyProfile } from "../lib/route";

interface Props {
  route: string;
}

const profile = loadProfile(Astro.props.route);
const W = 1000;
const H = 160;
const TOP = 12; // room for the stroke at the highest point
const x = (d: number) => (d / profile.lengthM) * W;
const y = (e: number) => TOP + (1 - (e - profile.minEle) / (profile.maxEle - profile.minEle)) * (H - TOP - 28);

// About two points per 4 units of the 1000-wide drawing: smooth at any
// width, with every peak and dip, at half the path data.
const samples = simplifyProfile(profile.samples, W / 4);
const line = (from = 0, to = profile.lengthM) =>
  samples
    .filter(([d]) => d >= from && d <= to)
    .map(([d, e], i) => `${i ? "L" : "M"}${x(d).toFixed(1)},${y(e).toFixed(1)}`)
    .join("");
const area = `${line()}L${W},${H}L0,${H}Z`;
const km = (m: number) => (m / 1000).toFixed(1);
---

<figure class="profile">
  <svg viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="none" aria-hidden="true">
    <path class="ground" d={area} />
    <g class="trace">
      <path class="road" d={line()} />
      {profile.segments.map((s) => <path class={s.type} d={line(s.from, s.to)} />)}
    </g>
  </svg>
  <figcaption>
    {profile.name}: {km(profile.lengthM)} km, {Math.round(profile.climbM)} m of climbing.
    One of the routes on the island, drawn from the game’s own map.
  </figcaption>
</figure>

<style>
  .profile {
    margin: 0;
    position: relative;
  }
  svg {
    display: block;
    width: 100%;
    height: clamp(90px, 14vw, 190px);
  }
  path {
    fill: none;
    vector-effect: non-scaling-stroke;
    stroke-linejoin: round;
    stroke-linecap: round;
  }
  .ground {
    fill: var(--bg);
  }
  .road {
    stroke: var(--terrain-edge);
    stroke-width: 2;
  }
  .climb {
    stroke: var(--climb);
    stroke-width: 4;
  }
  .sprint {
    stroke: var(--sprint);
    stroke-width: 4;
  }
  /* The route draws itself from start to finish, once. Only the line moves:
     the ground stays, so the hero never jumps. A clip-path follows the
     stretched viewBox, where a dash offset would be distorted. Not on paper,
     which would catch it half drawn. */
  @media screen and (prefers-reduced-motion: no-preference) {
    .trace {
      animation: draw 2.4s cubic-bezier(0.2, 0.7, 0.2, 1) 0.3s backwards;
    }
  }
  @keyframes draw {
    from {
      clip-path: inset(-50% 100% -50% 0);
    }
    to {
      clip-path: inset(-50% 0 -50% 0);
    }
  }
  figcaption {
    /* Full width (it covers whatever is behind), text aligned with .wrap. */
    padding-inline: max(var(--gutter), (100% - var(--max)) / 2);
    background: var(--bg);
    color: var(--muted);
    font-size: 0.875rem;
  }
</style>
